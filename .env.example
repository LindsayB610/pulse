# Copy this to a private .env file in your runner environment.
# Do not commit real credentials, recipients, or completion history.

PULSE_CONFIG_PATH=./pulses.example.yaml
PULSE_STATE_PATH=./state/pulse-dev.json
PULSE_RUNNER_TIMEZONE=America/Los_Angeles
PULSE_API_HOST=127.0.0.1
PULSE_API_PORT=8787
# Exact browser origins only when a desktop webview needs CORS; otherwise blank.
PULSE_API_ALLOWED_ORIGINS=

# Notification provider. Use console locally; use ntfy for Android push.
PULSE_RUNNER_MODE=demo
PULSE_NOTIFY_PROVIDER=console
PULSE_NTFY_SERVER=https://ntfy.sh
PULSE_NTFY_TOPIC=
PULSE_NTFY_TOKEN=

# Private Workshop/runner API. Generate a random value and never commit it.
PULSE_API_TOKEN=
