{
  "name": "@marketing-builds/pulse",
  "version": "0.0.0",
  "private": true,
  "description": "Persistent recurring obligations that keep notifying until done.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pulse-done": "./bin/pulse-done.mjs",
    "pulse-runner": "./bin/pulse-runner.mjs",
    "pulse-state": "./bin/pulse-state.mjs",
    "pulse-api": "./bin/pulse-api.mjs"
  },
  "exports": {
    ".": "./dist/index.js",
    "./workshop-plugin": {
      "types": "./plugin/dist/index.d.ts",
      "import": "./plugin/dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:plugin": "npm --prefix plugin run build",
    "prepare": "npm run build && npm run build:plugin",
    "docs:check": "node scripts/check-doc-links.mjs",
    "format:check": "node scripts/check-format.mjs",
    "lint": "node scripts/lint-public-boundary.mjs",
    "smoke:compose": "node scripts/smoke-compose.mjs",
    "test": "npm run build && npm run build:plugin && npm run typecheck:netlify && node --test test/*.test.mjs && tsx --test test/netlify-functions.test.ts",
    "test:coverage": "npm run build && npm run build:plugin && npm run typecheck:netlify && node --test --experimental-test-coverage test/*.test.mjs && tsx --test --experimental-test-coverage test/netlify-functions.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:netlify": "tsc -p netlify/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.13.0",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.11",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.12",
    "@netlify/functions": "^5.3.0",
    "yaml": "^2.9.0"
  }
}
